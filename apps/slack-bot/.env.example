# Required
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# The private E2E slack channel ID (e.g., C0123ABCDEF)
E2E_CHANNEL_ID=C0123456789

# Optional: limit incidents to those posted by a specific bot/user id
# E2E_NOTIFIER_USER_ID=U0123456789

# Optional: your Jira base url - used to detect and normalize jira links
JIRA_HOST=https://jira.example.com

# Local API port
PORT=8787

# Optional: if you want the bot to post reminders/leaderboards
ENABLE_BOT_POSTS=false
